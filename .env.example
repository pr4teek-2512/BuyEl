# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# Supabase dashboard > Project Settings > Database > Connection string > URI
# Use the session pooler (port 5432) for migrations, transaction pooler for runtime.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase (realtime + storage)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_SECRET=""

# ---------------------------------------------------------------------------
# SMS / OTP - APITxT unified OTP API
# Docs: https://apitxt.com/developer/otp-api
#
# SMS_PROVIDER = mock | apitxt
#   mock   - prints the OTP to the server log and shows it on the login screen
#   apitxt - POSTs to APITXT_ENDPOINT
#
# APITxT renders the message from the template on their side, which is what
# carries the DLT registration, so no message text is sent from here.
# APITXT_TEMPLATE_ID is optional: leave it blank to use the account default.
# ---------------------------------------------------------------------------
SMS_PROVIDER="mock"
APITXT_API_KEY=""
APITXT_ENDPOINT="https://apitxt.com/api/sendOTP"
APITXT_CHANNEL="sms"
APITXT_TEMPLATE_ID=""
APITXT_COUNTRY="91"

# ---------------------------------------------------------------------------
# Admin owner seed
# ---------------------------------------------------------------------------
ADMIN_OWNER_USERNAME="prateekchauhan"
ADMIN_OWNER_PASSWORD="Prateek@2512"
ADMIN_OWNER_NAME="Prateek Chauhan"
ADMIN_OWNER_OTP_PHONE="+917819812678"
