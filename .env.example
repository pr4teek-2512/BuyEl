# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# Supabase dashboard > Project Settings > Database > Connection string > URI
# Use the session pooler (port 5432) for migrations, transaction pooler for runtime.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase (realtime + storage)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_SECRET=""

# ---------------------------------------------------------------------------
# SMS / OTP
# SMS_PROVIDER = mock | apitxt
#   mock   - prints the OTP to the server log, used in development
#   apitxt - calls APITXT_REQUEST_URL
#
# APITXT_REQUEST_URL is a template. These placeholders are substituted and
# URL encoded: {API_KEY} {PHONE} {PHONE_NO_CC} {MESSAGE} {OTP} {SENDER} {TEMPLATE_ID}
# Example shape (confirm the real one against the APITxt docs):
#   https://api.apitxt.com/api/v1/sms?apikey={API_KEY}&sender={SENDER}&number={PHONE_NO_CC}&message={MESSAGE}&templateid={TEMPLATE_ID}
# ---------------------------------------------------------------------------
SMS_PROVIDER="mock"
APITXT_API_KEY=""
APITXT_REQUEST_URL=""
APITXT_REQUEST_METHOD="GET"
APITXT_SENDER_ID=""
APITXT_TEMPLATE_ID=""
OTP_MESSAGE_TEMPLATE="{OTP} is your BuyEl verification code. It is valid for 5 minutes. Do not share it with anyone."

# ---------------------------------------------------------------------------
# Admin owner seed
# ---------------------------------------------------------------------------
ADMIN_OWNER_USERNAME="prateekchauhan"
ADMIN_OWNER_PASSWORD="Prateek@2512"
ADMIN_OWNER_NAME="Prateek Chauhan"
ADMIN_OWNER_OTP_PHONE="+917819812678"
